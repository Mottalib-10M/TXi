generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum SharedRouteStatus {
  PENDING_DRIVER
  ACTIVE
  FULL
  DEPARTED
  CANCELLED
}

enum PassengerStatus {
  CONFIRMED
  CANCELLED
}

enum LuggageType {
  NONE
  SMALL
  LARGE
}

enum BookingSource {
  LANDING
  PROFILE
  ORGANIZATION
  P2P
}

enum CancelledBy {
  SYSTEM
  CLIENT
  DRIVER
}

enum OrgType {
  HOTEL
  HOSPITAL
  ENTERPRISE
  INDIVIDUAL
}

model Driver {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  slug         String   @unique
  phone        String   @default("")
  photoUrl     String?
  carteProUrl  String?   // Carte professionnelle de taxi (PDF ou image Cloudinary)
  bio          String?
  companyName  String?

  // Vehicle (flat fields = vehicle 1, kept for backward compat)
  vehicleBrand    String?
  vehicleModel    String?
  vehicleYear     Int?
  vehicleColor    String?
  vehiclePlate    String?
  vehicleCapacity Int      @default(4)
  vehicleFeatures String[] @default([])

  // Multi-vehicle support (JSON array of Vehicle objects, max 2)
  vehicles Json?

  // Coverage zone
  zoneLat     Float?
  zoneLng     Float?
  zoneRadius  Float    @default(15)
  zoneAddress String?

  // Pricing (defaults = tarifs plateforme TaxiNeo)
  baseFare           Float @default(2.70)
  pricePerKm         Float @default(2.24)
  pricePerKmNight    Float @default(3.36)
  pricePerMinute     Float @default(0.60)
  minimumFare        Float @default(15.0)
  airportSupplement  Float @default(4.0)
  nightSupplement    Float @default(0.0)
  customPrices       Json?

  // Availability (JSON: array of { day: 0-6, startTime: "HH:mm", endTime: "HH:mm" })
  availability Json?

  // Notification preferences
  notifyEmail Boolean @default(true)
  notifySms   Boolean @default(false)
  // Notifications de l'app sur le téléphone (src/lib/push.ts) : demandes, confirmations, annulations, rappels
  notifyPush  Boolean @default(true)

  // Status
  isActive      Boolean @default(true)
  isVerified    Boolean @default(false)
  emailVerified Boolean @default(false)
  // Compte suspendu par l'administration après un signalement (onglet Signalements) :
  // plus de connexion, plus de course, profil public masqué (isActive passe à false).
  suspendedAt   DateTime?

  // Activity tracking
  lastLoginAt DateTime?
  loginCount  Int       @default(0)

  // Referral / waitlist
  referralCode    String?  @unique
  referralCount   Int      @default(0)
  referredByCode  String?

  bookings         Booking[]       @relation("DriverBookings")
  referredBookings Booking[]       @relation("ReferredBookings")
  favoritedBy      FavoriteDriver[]
  sharedRoutes     SharedRoute[]
  reports          DriverReport[]
  blockedBy        DriverBlock[]    @relation("BlockedDriver")
  blocking         DriverBlock[]    @relation("BlockerDriver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("drivers")
}

model ReferralClick {
  id           String   @id @default(cuid())
  referralCode String
  visitorIp    String
  createdAt    DateTime @default(now())

  @@unique([referralCode, visitorIp])
  @@map("referral_clicks")
}

model Booking {
  id        String @id @default(cuid())
  reference String @unique

  // Client info
  clientName     String
  clientEmail    String
  clientPhone    String   @default("")
  clientComments String?

  // Departure
  departureName String
  departureLat  Float
  departureLng  Float

  // Arrival
  arrivalName String
  arrivalLat  Float
  arrivalLng  Float

  // Trip details
  requestedDate     DateTime
  passengerCount    Int          @default(1)
  estimatedDistance  Float?
  estimatedDuration Float?
  estimatedPrice    Float?

  // Tarif fixe garanti (figé à la création, ne change plus)
  lockedPrice Float?

  // Status
  status      BookingStatus @default(PENDING)
  source      BookingSource @default(LANDING)
  cancelledBy CancelledBy?

  // Escalation
  escalationPhase  Int       @default(0)   // 0=initial, 1=escalated, 2=admin notified
  escalatedAt      DateTime?
  invitedDriverIds String[]  @default([])

  // Driver relation
  driver   Driver? @relation("DriverBookings", fields: [driverId], references: [id])
  driverId String?

  // Organisation (optionnel - null = booking direct client)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  // P2P ride sharing
  referrerDriverId     String?
  referrerDriver       Driver?  @relation("ReferredBookings", fields: [referrerDriverId], references: [id])
  targetDriverName     String?
  targetDriverPhone    String?
  p2pCommissionRate    Float?
  p2pCommissionAmount  Float?
  p2pToken             String?  @unique
  // Ouverte aux chauffeurs proches faute de réponse du collègue en 30 min (src/lib/escalation.ts) :
  // les chauffeurs invités voient alors le chauffeur qui a transmis comme contact, pas le client.
  p2pOpenedAt          DateTime?
  // Course Taxineo refusée et passée à un collègue (« Passer à un collègue ») : le lien
  // p2pToken est partagé, sans les coordonnées du client ; compte pour le chauffeur référent.
  sharedByDriverId     String?
  sharedAt             DateTime?

  // Rappels de la course acceptée (src/app/api/cron/ride-reminders) : la veille au soir et une heure avant
  reminderEveSentAt  DateTime?
  reminderHourSentAt DateTime?

  // Langue du client lors de la réservation
  clientLocale String @default("fr")

  // Téléphone du client dans l'app (DeviceToken.id) : notifications de suivi de sa course
  clientDeviceId String?

  // Nom du bénéficiaire (patient, client hôtel, salarié)
  beneficiaryName String?

  // Cagnotte link
  cagnotteTransaction CagnotteTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bookings")
}

model Organization {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  type         OrgType
  contactName  String
  phone        String  @default("")
  address      String?

  // Cagnotte (5% des courses complétées)
  cagnotteBalance Float @default(0)

  emailVerified Boolean @default(false)

  // Activity tracking
  lastLoginAt DateTime?
  loginCount  Int       @default(0)

  bookings        Booking[]
  favoriteDrivers FavoriteDriver[]
  cagnotteHistory CagnotteTransaction[]
  blocking        DriverBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model FavoriteDriver {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  driver         Driver       @relation(fields: [driverId], references: [id])
  driverId       String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, driverId])
  @@map("favorite_drivers")
}

model CagnotteTransaction {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  booking        Booking      @relation(fields: [bookingId], references: [id])
  bookingId      String       @unique
  amount         Float
  createdAt      DateTime     @default(now())

  @@map("cagnotte_transactions")
}

model SharedRoute {
  id                  String            @id @default(cuid())
  driver              Driver?           @relation(fields: [driverId], references: [id])
  driverId            String?
  proposerName        String?
  proposerEmail       String?
  proposerPhone       String?
  departureLocationId String
  departureName       String
  departureLat        Float
  departureLng        Float
  destinationName     String
  destinationLat      Float
  destinationLng      Float
  departureTime       DateTime
  totalSeats          Int
  status              SharedRouteStatus @default(ACTIVE)
  passengers          SharedRoutePassenger[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("shared_routes")
}

model SharedRoutePassenger {
  id              String          @id @default(cuid())
  sharedRoute     SharedRoute     @relation(fields: [sharedRouteId], references: [id])
  sharedRouteId   String
  passengerName   String
  passengerEmail  String
  passengerPhone  String          @default("")
  seatCount       Int             @default(1)
  luggageType     LuggageType     @default(NONE)
  status          PassengerStatus @default(CONFIRMED)
  createdAt       DateTime        @default(now())

  @@map("shared_route_passengers")
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  ORG_BOOKING_CREATED
  ESCALATION_PHASE1
  ESCALATION_PHASE2
  CONTACT_REQUEST
  CONTACT_FORM
  SHARED_ROUTE_CREATED
  SHARED_ROUTE_PROPOSED
  SHARED_ROUTE_JOINED
  SHARED_ROUTE_DRIVER_ACCEPTED
  P2P_CREATED
  DRIVER_REPORTED
}

model AdminNotification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([type])
  @@index([createdAt])
  @@map("admin_notifications")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// Téléphones inscrits aux notifications de l'app (lib/push.ts, /api/push/register) :
// un chauffeur, une organisation, ou un client sans compte (relié à ses réservations
// par Booking.clientDeviceId).
model DeviceToken {
  id             String   @id @default(cuid())
  token          String   @unique
  /// ios ou android
  platform       String
  /// fr ou en : langue des notifications
  locale         String   @default("fr")
  driverId       String?
  organizationId String?
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  @@index([driverId])
  @@index([organizationId])
  @@map("device_tokens")
}

// Signalement d'un chauffeur (profil public, photo, comportement pendant une course),
// par un passager sans compte, une organisation ou un collègue. Traité par
// l'administration sous 2 heures (onglet Signalements, src/lib/moderation.ts).
model DriverReport {
  id            String    @id @default(cuid())
  driver        Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId      String
  /// client, organization ou driver
  reporterKind  String
  reporterId    String?
  reporterEmail String?
  bookingRef    String?
  /// behaviour, content, safety, price, other
  reason        String
  message       String?
  /// OPEN, ACTIONED (chauffeur suspendu ou contenu retiré), DISMISSED
  status        String    @default("OPEN")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([status])
  @@map("driver_reports")
}

// Chauffeur bloqué par une organisation (ne lui est plus jamais proposé) ou par un
// collègue (plus de course transmise entre eux, dans un sens comme dans l'autre).
model DriverBlock {
  id              String        @id @default(cuid())
  driver          Driver        @relation("BlockedDriver", fields: [driverId], references: [id], onDelete: Cascade)
  driverId        String
  blockerDriver   Driver?       @relation("BlockerDriver", fields: [blockerDriverId], references: [id], onDelete: Cascade)
  blockerDriverId String?
  blockerOrg      Organization? @relation(fields: [blockerOrgId], references: [id], onDelete: Cascade)
  blockerOrgId    String?
  createdAt       DateTime      @default(now())

  @@unique([driverId, blockerDriverId])
  @@unique([driverId, blockerOrgId])
  @@map("driver_blocks")
}
